# Set a unique production admin password (at least 16 characters)
ADMIN_PASSWORD=

# Session-signing secret (at least 32 random characters)
AUTH_SECRET=

# Public production origin used for canonical URLs, robots.txt, and sitemap.xml
SITE_URL=https://sampath-dev.is-a.dev

# Optional: paste the HTML-tag verification value from Google Search Console
GOOGLE_SITE_VERIFICATION=

# Supabase server credentials only. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend notification settings. CONTACT_FROM_EMAIL must be verified with Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional separate secret for hashing contact rate-limit identifiers
CONTACT_RATE_LIMIT_SECRET=
